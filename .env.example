
# API Keys
# Required for OpenAI-compatible endpoints
OPENAI_API_KEY=sk-proj-...

# Context Compressor Configuration
# Base URL for OpenAI-compatible API (should end with /v1)
BASE_URL=https://api.openai.com/v1
# Model to use for compression
MODEL=gpt-4.1-nano
# Compression level (1-10)
COMPRESSION_LEVEL=10
# File extensions to process (comma-separated, include 'no_ext' to process files without extensions)
FILE_EXTENSIONS=.md,.txt,no_ext,.mdc
# Maximum tokens per API call
MAX_TOKENS=32768
# API request timeout in seconds
API_TIMEOUT=600
# Number of retries before reducing compression level
COMPRESSION_RETRIES=5
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
